# Copy to .env.local for local overrides. Never commit real .env files.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser: never put secrets in them.
# No secrets or vendor credentials are needed in Phase 1.

# Absolute public URL of the site, used for canonical URLs, robots.txt and sitemap.xml.
# Optional. Falls back to Vercel's production URL, then http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Set to "true" to allow search engines to index the site. Defaults to off (noindex)
# while product areas are placeholders. See docs/DECISIONS.md D-024.
NFAI_ALLOW_INDEXING=
