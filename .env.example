# Copy to .env.local for local overrides. Never commit real .env files.
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser: never put secrets in them.
# This file contains placeholders only.

# Absolute public URL of the site, used for canonical URLs, robots.txt and sitemap.xml.
# Optional. Falls back to Vercel's production URL, then http://localhost:3000.
NEXT_PUBLIC_SITE_URL=

# Set to "true" to allow search engines to index the site. Defaults to off (noindex)
# while product areas are placeholders. See docs/DECISIONS.md D-024.
NFAI_ALLOW_INDEXING=

# Supabase (Phase 2). Optional: the app builds and runs without them. For a local stack,
# `supabase start` prints these values. The URL and anon key are public by design; Row
# Level Security protects the data. Admin sign-in (/admin, Phase 3) needs the URL and anon
# key; admin actions run with the signed-in admin's own session, never the service role.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SECRET. Bypasses Row Level Security. Server-only: read only by modules that import
# "server-only". Never prefix with NEXT_PUBLIC_, never expose to the browser, never commit.
SUPABASE_SERVICE_ROLE_KEY=
